<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <template id="report_lease_summary">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2> Lease Summary: <span t-field="o.name"/></h2>

                        </div>
                        
                        <!-- Lease Details -->
                        <div class="row mt-4">
                            <div class="col-6">
                                <strong>Property:</strong>
                                <span t-field="o.property_id.name"/>
                            </div>
                            <div class="col-6">
                                <strong>Lease Status:</strong>
                                <span t-field="o.state"/>
                            </div>
                        </div>
                         <div class="row mb-3">
                            <div class="col-6">
                                <strong>Total Actual Maintenance Cost:</strong>
                                <span t-esc="total_actual_costs.get(o.id)"/>
                            </div>

                        <div class="row mt-2">
                            <div class="col-6">
                                <strong>Tenant:</strong>
                                <span t-field="o.tenant_id"/>
                            </div>
                            <div class="col-6">
                                <strong>Property Type:</strong>
                                <span t-field="o.property_id.property_type"/>
                            </div>
                        </div>

                        <div class="row mt-2">
                            <div class="col-6">
                                <strong>Start Date:</strong>
                                <span t-field="o.start_date"/>
                            </div>
                            <div class="col-6">
                                <strong>End Date:</strong>
                                <span t-field="o.end_date"/>
                            </div>
                        </div>
 
                        <!-- Lease Financials -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <h4>Lease Financials</h4>
                                <table class="table table-sm">
                                    <tr>
                                        <td><strong>Monthly Rent:</strong></td>
                                        <td class="text-end">
                                            <span t-field="o.monthly_rent"
                                                  t-options="{'widget': 'monetary', 'display_currency': o.property_id.currency_id}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><strong>Deposit Paid:</strong></td>
                                        <td class="text-end">
                                            <span t-field="o.deposit_paid"
                                                  t-options="{'widget': 'monetary', 'display_currency': o.property_id.currency_id}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><strong>Total Payments Recorded:</strong></td>
                                        <td class="text-end">
                                            <span t-esc="payment_totals.get(o.id, 0.0)"
                                                  t-options="{'widget': 'monetary', 'display_currency': o.property_id.currency_id}"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td><strong>Maintenance Costs (6 months):</strong></td>
                                        <td class="text-end">
                                            <span t-esc="maintenance_costs.get(o.id, 0.0)"
                                                  t-options="{'widget': 'monetary', 'display_currency': o.property_id.currency_id}"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <div class="row mt-4">
                            <div class="col-12">
                                <h4>Maintenance Request History</h4>
                                <t t-if="o.maintenance_ids">
                                    <table class="table table-sm table-borderd">
                                        <thead>
                                            <tr>
                                                <th>Date</th>
                                                <th>Issue</th>
                                                <th>Description</th>
                                                <th>Urgency</th>
                                                <th>Status</th>
                                                <th class="text-end">Actual Cost</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="o.maintenance_ids.sorted('create_date', reverse=True)" t-as="request">
                                                <tr>
                                                    <td><span t-field="request.create_date"/></td>
                                                    <td><span t-field="request.issue_type"/></td>
                                                    <td><span t-field="request.description"/></td>
                                                    <td><span t-field="request.urgency"/></td>
                                                    <td><span t-field="request.state"/></td>
                                                    <td class="text-end">
                                                        <span t-field="request.actual_cost"
                                                              t-options="{'widget': 'monetary', 'display_currency': o.property_id.currency_id}"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </t>
                                <t t-else="">
                                    <p class="text-muted">No maintenance requests for this lease.</p>
                                </t>
                            </div>
                        </div>

                        <!-- Footer Note -->
                        <div class="row mt-5">
                            <div class="col-12">
                                <p class="text-muted">
                                    <small>
                                        Generated on <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M')"/>
                                    </small>
                                </p>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
